{
  "name": "gerocare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache --cache-location .eslintcache --ignore-pattern 'storybook-static/**' --ignore-pattern 'dist/**' --ignore-pattern 'dist-ssr/**' && echo '✅ ESLint: No issues found'",
    "format": "prettier --write --cache --cache-location .prettiercache --cache-strategy metadata \"src/**/*.{ts,tsx,vue}\" \"*.config.{ts,js}\" \"e2e/**/*.ts\"",
    "emulators": "firebase emulators:start --only \"firestore,auth\" --export-on-exit --import=./firestore_export",
    "dev:emulators": "npm-run-all --parallel dev emulators",
    "seed": "tsx src/scripts/seed.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "firebase": "12.8.0",
    "pinia": "3.0.4",
    "vue": "3.5.26",
    "vue-router": "4.6.4",
    "vuefire": "3.2.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.0.0",
    "@faker-js/faker": "10.2.0",
    "@playwright/test": "1.57.0",
    "@storybook/addon-a11y": "10.1.11",
    "@storybook/addon-docs": "10.1.11",
    "@storybook/addon-vitest": "10.1.11",
    "@storybook/vue3-vite": "10.1.11",
    "@testing-library/user-event": "14.6.1",
    "@testing-library/vue": "8.1.0",
    "@tsconfig/node24": "24.0.4",
    "@types/jsdom": "27.0.0",
    "@types/node": "25.0.9",
    "@vitejs/plugin-vue": "6.0.3",
    "@vitest/browser-playwright": "4.0.17",
    "@vitest/coverage-v8": "4.0.17",
    "@vitest/eslint-plugin": "1.6.6",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.6.0",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.8.1",
    "eslint": "9.39.2",
    "eslint-plugin-playwright": "2.5.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-storybook": "10.1.11",
    "eslint-plugin-vue": "10.7.0",
    "firebase-tools": "15.3.1",
    "jiti": "2.6.1",
    "tsx": "^4.19.2",
    "jsdom": "27.4.0",
    "npm-run-all2": "8.0.4",
    "playwright": "1.57.0",
    "prettier": "3.8.0",
    "storybook": "10.1.11",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-vue-devtools": "8.0.5",
    "vitest": "4.0.17",
    "vue-tsc": "3.2.2"
  }
}