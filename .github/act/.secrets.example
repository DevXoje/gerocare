# Template de secrets para act
# Copiar este archivo a .github/act/.secrets y completar los valores
# 
# Uso:
#   cp .github/act/.secrets.example .github/act/.secrets
#   # Editar .github/act/.secrets con tus valores reales
#
# Nota: .github/act/.secrets está en .gitignore y no se subirá al repositorio

# GitHub Token (opcional, solo si necesitas acceso a GitHub API)
# GITHUB_TOKEN=

# Otras variables de entorno necesarias para tus workflows
# VARIABLE_EJEMPLO=valor
